<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="electrifier.Controls.ShellBrowser"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:electrifier.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             mc:Ignorable="d">

    <Grid MinWidth="400"
          MinHeight="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  Left-side 'Shelf', In this case you could also use a GridSplitter  -->
        <Border x:Name="SideContent"
                MinWidth="200"
                MaxWidth="600">
            <local:ShellNamespaceTreeControl />
        </Border>
        <controls:ContentSizer Grid.Column="1"
                               TargetControl="{x:Bind SideContent}" />
        <local:ShellListView Grid.Column="2" />
    </Grid>
</UserControl>
